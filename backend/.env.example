# Backend only: use a dedicated SELECT-only PostgreSQL login, never the postgres owner.
# URL-encode special characters in the password. TLS is required for production.
DATABASE_URL=postgresql://pickou_api_reader:REPLACE_ME@YOUR_POOLER_HOST:5432/postgres?ssl=require
CORS_ORIGINS=https://pickou.example.com
DB_POOL_MIN=1
DB_POOL_MAX=5
DB_TIMEOUT_SECONDS=5
